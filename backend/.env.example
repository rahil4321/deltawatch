# Optional; defaults are suitable for local development.
DELTAWATCH_DATA_DIR=./data
DELTAWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DELTAWATCH_CHECK_TIMEOUT_SECONDS=25
DELTAWATCH_WORKERS=3
DELTAWATCH_ENABLE_SCHEDULER=true
# If Playwright cannot find its bundled browser, set this to your Chromium binary path:
# DELTAWATCH_CHROMIUM_EXECUTABLE=/usr/bin/chromium
DELTAWATCH_PUBLIC_APP_URL=http://localhost:5173
# Optional SMTP configuration. Leave blank to disable email alerts.
DELTAWATCH_SMTP_HOST=
DELTAWATCH_SMTP_PORT=587
DELTAWATCH_SMTP_USERNAME=
DELTAWATCH_SMTP_PASSWORD=
DELTAWATCH_SMTP_FROM=
DELTAWATCH_SMTP_USE_TLS=true
